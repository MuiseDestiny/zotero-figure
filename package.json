{
  "name": "zotero-figure",
  "version": "1.0.0",
  "description": "Local figure and table extraction for Zotero PDFs",
  "config": {
    "addonName": "PDF Figure",
    "addonID": "zoterofigure@polygon.org",
    "addonRef": "zoterofigure",
    "addonInstance": "ZoteroFigure",
    "prefsPrefix": "extensions.zotero.zoterofigure",
    "updateLink": "https://github.com/MuiseDestiny/zotero-figure/releases/latest/download/zotero-figure.xpi",
    "updateURL": "https://raw.githubusercontent.com/MuiseDestiny/zotero-figure/bootstrap/update.json"
  },
  "main": "src/index.ts",
  "scripts": {
    "start": "node scripts/server.mjs",
    "build": "node scripts/build.mjs production",
    "build:check": "node scripts/check-build.mjs",
    "build:dev": "node scripts/build.mjs development",
    "benchmark:models": "node scripts/benchmark-layout-models.mjs",
    "check:scripts": "node scripts/check-scripts.mjs",
    "compare:models": "node scripts/compare-layout-models.mjs",
    "stop": "node scripts/stop.mjs",
    "restart": "npm run stop && npm start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src tests typing --ext .ts",
    "lint:fix": "eslint src tests typing --ext .ts --fix",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "node scripts/run-tests.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run check:scripts && npm run build:check",
    "release": "release-it --only-version --preReleaseId=beta",
    "update-deps": "npm update --save"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MuiseDestiny/zotero-figure.git"
  },
  "author": "Polygon",
  "license": "AGPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/MuiseDestiny/zotero-figure/issues"
  },
  "homepage": "https://github.com/MuiseDestiny/zotero-figure#readme",
  "engines": {
    "node": ">=20.10"
  },
  "dependencies": {
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@huggingface/transformers": "^3.8.1",
    "codemirror": "^6.0.2",
    "katex": "^0.16.22",
    "mupdf": "1.28.0",
    "zotero-plugin-toolkit": "^5.1.0-beta.4"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/node": "^20.10.4",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "chokidar": "^3.5.3",
    "compressing": "^1.10.0",
    "esbuild": "^0.19.9",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "onnxruntime-web": "1.22.0-dev.20250409-89f8206ba4",
    "prettier": "^3.1.1",
    "release-it": "^17.0.1",
    "replace-in-file": "^7.0.2",
    "typescript": "5.3.3",
    "zotero-types": "^3.0.1"
  },
  "prettier": {
    "endOfLine": "lf",
    "printWidth": 80,
    "tabWidth": 2,
    "overrides": [
      {
        "files": "*.xhtml",
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
